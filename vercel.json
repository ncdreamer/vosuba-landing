{
  "redirects": [
    {
      "source": "/download/Vosuba-1.0.1-macOS.dmg",
      "destination": "https://github.com/ncdreamer/vosuba-landing/releases/download/v1.0.1/Vosuba-1.0.1-macOS.dmg",
      "statusCode": 302
    },
    {
      "source": "/download/Vosuba-1.0.0-macOS.dmg",
      "destination": "https://github.com/ncdreamer/vosuba-landing/releases/download/v1.0.1/Vosuba-1.0.1-macOS.dmg",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/download.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
